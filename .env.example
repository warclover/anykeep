# ===========================================
# AnyKeep 环境变量配置模板
# ===========================================
# 复制此文件为 .env.local 并填入实际值
# cp .env.example .env.local
#
# ⚠️ 安全提醒：请勿在此文件中填入真实密钥！
# 此文件会被提交到版本控制系统。

# -------------------------------------------
# Supabase 配置（必填）
# -------------------------------------------
# 从 Supabase Dashboard -> Settings -> API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key（仅服务端使用，切勿暴露给客户端）
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -------------------------------------------
# AI 服务配置（可选，用于摘要和标签生成）
# -------------------------------------------
# OpenAI API Key（用于 Embedding 向量生成）
OPENAI_API_KEY=sk-your-openai-key-here

# DeepSeek API Key（可选，用于中文摘要生成）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# DashScope API Key（阿里云通义，用于 Embedding 向量生成）
# 获取地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# -------------------------------------------
# 应用配置
# -------------------------------------------
# 应用 URL（生产环境需要修改）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# 开发环境配置（可选）
# -------------------------------------------
# Node 环境
NODE_ENV=development


SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# -------------------------------------------
# AI 功能开关（可选，默认启用）
# -------------------------------------------
# 设置为 false 可禁用对应功能

# 核心 AI 功能
# ENABLE_DYNAMIC_CONTEXT=true      # 动态上下文注入
# ENABLE_MODEL_TIERING=true        # 模型分层策略
# ENABLE_REACT_PROMPT=true         # ReAct Prompt
# ENABLE_REASONING=true            # reasoning 参数记录
# ENABLE_ERROR_RECOVERY=true       # 智能错误恢复
# ENABLE_PREFERENCE_LEARNING=true  # 偏好自动学习
# ENABLE_COST_CONTROL=true         # 成本控制

# 任务理解层
# ENABLE_TASK_UNDERSTANDING=true   # 任务理解层总开关
# ENABLE_ZERO_TAKEOVER=true        # 零接管模式
# ENABLE_SYSTEM_REMINDER=true      # System-Reminder 动态注入

# ReAct 循环（灰度发布中，默认关闭）
# ENABLE_REACT_LOOP=false          # ReAct 循环执行
# ENABLE_CITATION_TRACKING=true    # 引用追踪系统

# -------------------------------------------
# 多用户画像功能配置 [Phase 4]
# -------------------------------------------

# 画像功能主开关（设为 true 启用）
ENABLE_MULTI_PERSONA=false

# 灰度发布百分比（0-100，控制用户覆盖范围）
PERSONA_ROLLOUT_PERCENTAGE=0

# 画像功能子开关（在主开关启用后生效）
# ENABLE_PERSONA_INFERENCE=true     # 画像推断引擎
# ENABLE_PERSONA_PROMPTS=true       # 画像专属 Prompt
# ENABLE_PERSONA_INTENT_BOOST=true  # 画像意图权重加成
# ENABLE_PERSONA_SETTINGS_UI=false  # 设置页面 UI（谨慎启用）

# Phase 1 画像开关
# ENABLE_PM_PERSONA=true            # 产品经理画像
# ENABLE_CONSULTANT_PERSONA=true    # 咨询顾问画像
# ENABLE_TEACHER_PERSONA=true       # 大学教师画像

# 灰度发布阶段（可选）
# PERSONA_ROLLOUT_STAGE=internal    # internal|beta|canary|production

# -------------------------------------------
# 智能分类 v5.0 配置 [2026-01-18]
# -------------------------------------------

# 智能分类 v5.0 主开关（设为 true 启用）
CLASSIFICATION_V5_ENABLED=true

# 灰度发布百分比（0-100，控制用户覆盖范围）
# 建议发布流程：0% → 1% → 5% → 20% → 50% → 100%
CLASSIFICATION_V5_ROLLOUT_PERCENTAGE=0

# 白名单用户（逗号分隔的用户 ID，这些用户始终使用 v5.0）
# 示例：CLASSIFICATION_V5_WHITELIST=user-id-1,user-id-2,user-id-3
CLASSIFICATION_V5_WHITELIST=

# 黑名单用户（逗号分隔的用户 ID，这些用户始终不使用 v5.0）
# 示例：CLASSIFICATION_V5_BLACKLIST=user-id-4,user-id-5
CLASSIFICATION_V5_BLACKLIST=

# -------------------------------------------
# 智能分类 v5.0 说明
# -------------------------------------------
# v5.0 新特性：
# - 双源向量（内容向量 + 行为向量）
# - 动态 α 系数自适应
# - T0/T1 两阶段分类（快速生成 + LLM 纠正）
# - 混合检索（向量 70% + 行为 30%）
# - 文件夹园丁（自适应阈值、同义词检测、智能命名）
#
# 依赖的 API Key：
# - OPENAI_API_KEY: 用于生成 1024 维内容向量
# - DEEPSEEK_API_KEY: 用于 T1 LLM 纠正
#
# 监控端点：
# - GET /api/classification/v5/metrics?days=7
# - GET /api/classification/v5/rollout/status
#
# 灰度发布管理：
# - POST /api/classification/v5/rollout/stage (更新发布阶段)
# - POST /api/classification/v5/rollout/rollback (手动回滚)
