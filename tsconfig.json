{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/classification/*": ["./src/lib/_archived/classification-v1/*"],
      "@/lib/classification": ["./src/lib/_archived/classification-v1"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "figma1121",
    "browser-extension",
    "extension",
    "supabase/functions",
    "scripts",
    "_backup",
    "backups",
    "已完成",
    "docs/templates",
    "src/lib/_archived/classification-v1/_deprecated_v3/**",
    "src/lib/_archived/classification-v1/strategies/classic/**",
    "src/lib/fluid-agent/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
