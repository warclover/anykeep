# ===========================================
# AnyKeep v5.5 晶体生长系统环境变量
# ===========================================

# v5.5 主开关（灰度发布时设为 true）
V55_ENABLED=false

# 灰度比例 (0-100)
# 0 = 全部关闭, 100 = 全部开启
V55_ROLLOUT_PERCENT=0

# 子功能开关（默认全部启用，设为 false 可禁用）
V55_CHAOS_POOL_ENABLED=true        # 混沌池写入
V55_CRYSTAL_GROWTH_ENABLED=true    # 晶体生长（静默创建）
V55_ASYNC_NAMING_ENABLED=true      # 异步命名优化
V55_SILENT_NOTIFICATION=true       # 静默通知

# 调试开关
V55_SHADOW_MODE=true               # 影子模式（仅记录不执行，建议先开启观察）
V55_DEBUG_LOG=false                # 详细日志

# 配额配置（可选，有默认值）
# AI_FOLDER_HARD_CAP=30            # AI 文件夹硬上限
# TOTAL_FOLDER_HARD_CAP=50         # 总文件夹硬上限
# FOLDER_SOFT_CAP_RATIO=0.15       # 软上限比例（书签数 × 比例）
