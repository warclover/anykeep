# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Windows batch files require CRLF
*.{cmd,bat} text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Keep these files with their original line endings
*.lock -text
